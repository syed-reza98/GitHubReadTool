# GitHubReadTool Resume Builder Configuration
# Copy this file to '.env' and update with your actual tokens

# GitHub Models API Configuration (Required for AI features)
# Get your token from: https://github.com/marketplace/models
GITHUB_TOKEN=your_github_models_token_here
MODEL_ENDPOINT=https://models.github.ai
DEFAULT_MODEL=openai/gpt-4o-mini

# GitHub Repository API Configuration (Required for project data)
# Get your token from: https://github.com/settings/tokens
# Note: Can use same token as GITHUB_TOKEN for both APIs
GITHUB_REPO_TOKEN=your_github_repo_token_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Resume Configuration
MAX_PROJECTS=8
DEFAULT_TEMPERATURE=0.7
MAX_TOKENS=2000

# Production Configuration (GitHub Pages)
# The following token is used in production for GitHub Pages deployment
# It's injected via GitHub Secrets as MODELS_API_TOKEN
# MODELS_API_TOKEN=your_production_token_here

# Instructions:
# 1. Create a GitHub account if you don't have one
# 2. Get GitHub Models API access: https://github.com/marketplace/models
# 3. Generate a GitHub Personal Access Token: https://github.com/settings/tokens
#    - Select scopes: repo, read:user, read:org
# 4. Replace 'your_github_models_token_here' with your GitHub Models token
# 5. Replace 'your_github_repo_token_here' with your GitHub PAT
# 6. Save this file as '.env' (remove the .example extension)
# 7. Restart the server

# Security Notes:
# - Never commit .env files to version control
# - Keep your tokens secure and rotate them regularly
# - For production deployment, use GitHub Secrets (MODELS_API_TOKEN)
